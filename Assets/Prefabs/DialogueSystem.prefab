  m_Script: {fileID: 11500000, guid: 685b797368a572648bf03133743fc836, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  nameText: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueGroup: {fileID: 0}
  typingSpeed: 0.03
  nextScene: 0
  dialogueLines:
  - speakerName: Hale
    text: "Another long night\u2026 another case the city forgot about."
    displayTime: 3
  - speakerName: Hale
    text: Five victims. All with the same mark. They called it the Hollow Point Killings.
    displayTime: 4
  - speakerName: Hale
    text: "But no one ever found where it started\u2026 until tonight."
    displayTime: 3
  - speakerName: Hale
    text: "Signal came from somewhere out here. Middle of nowhere\u2026 figures."
    displayTime: 3
  - speakerName: Hale
    text: If the coordinates are right, the trail ends near an old cave system.
    displayTime: 3
  - speakerName: Hale
    text: "Alright\u2026 let\u2019s see what you\u2019re hiding."
    displayTime: 2
  - speakerName: Hale
    text: "Looks like someone\u2019s been down here recently\u2026"
    displayTime: 3
  - speakerName: Hale
    text: "What was that\u2026?"
    displayTime: 2
  - speakerName: Hale
    text: "\u2026Guess I\u2019m not alone."
    displayTime: 3
  - speakerName: Hale
    text: "Alright then. Let\u2019s dance."
    displayTime: 2
  timelineDirector: {fileID: 0}
